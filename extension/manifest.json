{
  "manifest_version": 3,
  "name": "Media Extractor",
  "version": "8.0.0",
  "description": "Download videos and photo posts from YouTube, Instagram, X, Reddit, TikTok and Facebook.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "storage", "nativeMessaging", "scripting"],
  "action": {
    "default_title": "Open Media Extractor",
    "default_popup": "app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
