{
  "manifest_version": 3,
  "name": "YouTube Video Downloader",
  "version": "3.0.0",
  "description": "Download YouTube videos and Shorts with audio using your local helper.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "action": {
    "default_title": "Open YouTube Video Downloader"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
